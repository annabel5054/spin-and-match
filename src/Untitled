const DOT_GAP = 22;
const DOT_REACH = 150;
const DOT_PUSH = 24;
const RIPPLE_SPEED = 380;
const RIPPLE_WIDTH = 80;
const RIPPLE_LIFE = 1400;
const RIPPLE_MAX = 6;
const COLOR_REFRESH_FRAMES = 30;

// Dot grid that bends away from the pointer and sends a ripple out from every tap.
function DotGridBackground() {
  const canvasRef = useRef(null);

  useEffect(() => {
    const canvas = canvasRef.current;
    const g = canvas.getContext("2d");
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const mouse = { x: 0, y: 0, tx: 0, ty: 0, power: 0, active: false };
    let ripples = [];
    let w = 0;
    let h = 0;
    let raf = 0;
    let frameNo = 0;
    let dotColor = "";
    let nearColor = "";

    const fit = () => {
      w = canvas.parentElement.clientWidth;
      h = canvas.parentElement.clientHeight;
      const dpr = window.devicePixelRatio || 1;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      g.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    const ro = new ResizeObserver(fit);
    ro.observe(canvas.parentElement);
    fit();

    const toLocal = (e) => {
      const r = canvas.getBoundingClientRect();
      return { x: e.clientX - r.left, y: e.clientY - r.top };
    };
    const onMove = (e) => {
      const p = toLocal(e);
      if (!mouse.active) {
        mouse.x = p.x;
        mouse.y = p.y;
      }
      mouse.tx = p.x;
      mouse.ty = p.y;
      mouse.active = true;
    };
    const onDown = (e) => {
      onMove(e);
      if (reduced) return;
      ripples.push({ x: mouse.tx, y: mouse.ty, t: performance.now() });
      if (ripples.length > RIPPLE_MAX) ripples.shift();
    };
    const onLeave = () => {
      mouse.active = false;
    };
    const onUp = (e) => {
      if (e.pointerType === "touch") mouse.active = false;
    };
    window.addEventListener("pointermove", onMove);
    window.addEventListener("pointerdown", onDown);
    window.addEventListener("pointerup", onUp);
    window.addEventListener("pointercancel", onUp);
    window.addEventListener("blur", onLeave);
    document.documentElement.addEventListener("pointerleave", onLeave);

    const frame = (now) => {
      if (frameNo++ % COLOR_REFRESH_FRAMES === 0) {
        const cs = getComputedStyle(canvas);
        dotColor = cs.getPropertyValue("--sam-dot");
        nearColor = cs.getPropertyValue("--sam-dot-near");
      }
      mouse.power += ((mouse.active ? 1 : 0) - mouse.power) * 0.08;
      mouse.x += (mouse.tx - mouse.x) * 0.18;
      mouse.y += (mouse.ty - mouse.y) * 0.18;
      ripples = ripples.filter((r) => now - r.t < RIPPLE_LIFE);
      const t = reduced ? 0 : now / 1000;

      g.clearRect(0, 0, w, h);
      const far = new Path2D();
      const near = [];

      for (let y = DOT_GAP / 2; y < h; y += DOT_GAP) {
        for (let x = DOT_GAP / 2; x < w; x += DOT_GAP) {
          let px = x;
          let py = y;
          let boost = 0;

          const dx = x - mouse.x;
          const dy = y - mouse.y;
          const d = Math.hypot(dx, dy) || 1;
          const prox = Math.max(0, 1 - d / DOT_REACH) * mouse.power;
          if (prox > 0) {
            px += (dx / d) * prox * DOT_PUSH;
            py += (dy / d) * prox * DOT_PUSH;
          }

          for (const r of ripples) {
            const age = now - r.t;
            const rx = x - r.x;
            const ry = y - r.y;
            const rd = Math.hypot(rx, ry) || 1;
            const off = rd - (age / 1000) * RIPPLE_SPEED;
            if (Math.abs(off) < RIPPLE_WIDTH) {
              const amp = Math.cos((off / RIPPLE_WIDTH) * (Math.PI / 2)) * (1 - age / RIPPLE_LIFE) * 14;
              px += (rx / rd) * amp;
              py += (ry / rd) * amp;
              boost += amp * 0.12;
            }
          }

          const radius = 1.3 + Math.sin((x + y) * 0.035 + t * 2) * 0.45 + prox * 2.6 + boost;
          if (prox > 0.04) {
            near.push(px, py, radius, prox);
          } else {
            far.moveTo(px + radius, py);
            far.arc(px, py, radius, 0, Math.PI * 2);
          }
        }
      }

      g.fillStyle = dotColor;
      g.fill(far);
      g.fillStyle = nearColor;
      for (let i = 0; i < near.length; i += 4) {
        g.globalAlpha = 0.25 + near[i + 3] * 0.4;
        g.beginPath();
        g.arc(near[i], near[i + 1], near[i + 2], 0, Math.PI * 2);
        g.fill();
      }
      g.globalAlpha = 1;

      raf = requestAnimationFrame(frame);
    };
    raf = requestAnimationFrame(frame);

    return () => {
      cancelAnimationFrame(raf);
      ro.disconnect();
      window.removeEventListener("pointermove", onMove);
      window.removeEventListener("pointerdown", onDown);
      window.removeEventListener("pointerup", onUp);
      window.removeEventListener("pointercancel", onUp);
      window.removeEventListener("blur", onLeave);
      document.documentElement.removeEventListener("pointerleave", onLeave);
    };
  }, []);

  return <canvas ref={canvasRef} className="sam-dots" aria-hidden="true" />;
}